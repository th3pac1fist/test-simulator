# Fighter Lab server settings. Copy this file to .env (git ignores .env) and fill it in.
# Keys in here are for TEST wallets only. Never use a wallet that holds real funds,
# and never paste a key into a chat, an issue or a commit.

PORT=8787
ORIGIN=http://localhost:8787
# Base Sepolia. The server refuses to start on any network with real money.
CHAIN_ID=84532
# DB_FILE=./fighter-lab.db
# TRUST_PROXY=1            # only behind a reverse proxy that sets X-Forwarded-For

# ---- test token (leave TOKEN_ADDRESS empty to run the game without the wallet) ----
RPC_URL=https://sepolia.base.org
# The server's voucher-signing key: a fresh key used for nothing else (npm run new-key).
SIGNER_KEY=
# From npm run deploy:
TOKEN_ADDRESS=
START_BLOCK=
# CONFIRMATIONS=2
# SYNC_SECONDS=15
# EXPLORER_URL=https://sepolia.basescan.org

# ---- only for npm run deploy: a TEST wallet with a little Base Sepolia ETH from a faucet ----
DEPLOYER_KEY=
